NODE_ENV=development
PORT=3000

# ---- Database (AWS RDS Postgres in production) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=ssc_app
DB_PASSWORD=change_me
DB_NAME=student_smart_card
DB_LOGGING=false
# Use SSL in production (AWS RDS requires it). true for prod, false for local.
DB_SSL=false

# ---- JWT (long random strings, min 16 chars each; generate fresh for the new deployment) ----
JWT_ACCESS_SECRET=change_me_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HASH_PEPPER=change_me_min_8_chars

BCRYPT_SALT_ROUNDS=10

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# MAIL_FROM domain MUST be a domain you control with SPF/DKIM/DMARC configured,
# otherwise mail lands in spam. Match it to your live site domain.
MAIL_FROM="Student Smart Card <no-reply@studentsmartcardpak.com>"
# Where replies go (defaults to the MAIL_FROM address when left empty).
MAIL_REPLY_TO=
# DKIM signing (strongly recommended for inbox placement). Set all three to sign mail.
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=

# ---- URLs ----
# Comma-separated list of allowed browser origins (your frontend domain in prod).
CORS_ORIGIN=http://localhost:5173
# Used to build links in emails (setup, tracking, verification). Must be the domain
# that serves the CURRENT frontend build in production.
FRONTEND_URL=http://localhost:5173

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ---- E-commerce integration (card-verification partner API key, min 16 chars) ----
ECOMMERCE_API_KEY=change_me_min_16_chars

# Validity of a newly issued card, in months.
CARD_VALIDITY_MONTHS=12
